//! Browser-target probe, generated by `tools/bench/wasm_check.sh`.
//!
//! `wasm32-unknown-unknown` has no WASI, no clock and no threads -- the shape a
//! web page gives you. Each export returns an FNV-1a the host can be compared
//! against, so the question is bit-exactness rather than "did it build".
use rusty_mp3::{Mp3Decoder, Mp3Encoder, Mp3EncoderConfig};

static FIXTURE: &[u8] = include_bytes!("@FIXTURE@");

fn fnv_f32(h: &mut u64, s: &[f32]) {
    for v in s {
        for b in v.to_bits().to_le_bytes() {
            *h ^= b as u64;
            *h = h.wrapping_mul(0x0000_0100_0000_01b3);
        }
    }
}

/// CONTROL. This target has no clock, so this MUST trap. If it stops trapping the
/// target gained one, and `prof::time`'s cfg should be revisited -- a probe whose
/// good news is "nothing trapped" must prove it can still trap.
#[no_mangle]
pub extern "C" fn probe_clock() -> u64 {
    std::time::Instant::now().elapsed().as_nanos() as u64
}

#[no_mangle]
pub extern "C" fn decode_hash() -> u64 {
    let mut dec = Mp3Decoder::new();
    dec.push(FIXTURE);
    dec.flush();
    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
    while let Ok(f) = dec.next_frame() {
        fnv_f32(&mut h, &f.samples);
    }
    h
}

/// The float-heavy half: filterbank, MDCT, psymodel, two-loop quantizer.
#[no_mangle]
pub extern "C" fn encode_hash() -> u64 {
    let sr = 44100u32;
    let pcm: Vec<f32> = (0..sr as usize / 2)
        .map(|i| {
            let t = i as f32 / sr as f32;
            0.4 * (2.0 * core::f32::consts::PI * 440.0 * t).sin()
                + 0.2 * (2.0 * core::f32::consts::PI * 1109.0 * t).sin()
        })
        .collect();
    let mut enc = Mp3Encoder::new(Mp3EncoderConfig {
        bitrate_kbps: 192,
        vbr_quality: None,
    });
    if enc.push_pcm_f32(&pcm, 1, sr).is_err() {
        return 0;
    }
    enc.finish();
    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
    while let Ok(p) = enc.next_packet() {
        for &b in &p {
            h ^= b as u64;
            h = h.wrapping_mul(0x0000_0100_0000_01b3);
        }
    }
    h
}

/// The threaded decode path. There are no threads here, so this exercises the
/// serial fallback -- and must return the SAME hash as `decode_hash`.
#[no_mangle]
pub extern "C" fn pipelined_hash() -> u64 {
    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
    for f in rusty_mp3::decode_pipelined(FIXTURE) {
        fnv_f32(&mut h, &f.samples);
    }
    h
}
